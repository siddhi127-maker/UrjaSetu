# UrjaSetu Environment Configuration
# Copy this to .env and fill in your values

# OpenWeatherMap API Key (free tier: https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=

# Village location (default: Jaipur, Rajasthan)
WEATHER_LATITUDE=26.9124
WEATHER_LONGITUDE=75.7873

# Twilio SMS Alerts (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Debug mode
DEBUG=true
